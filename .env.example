# Copy to ~/.yfr/.env (works from any directory) or ./.env. Never commit the real file.
ANTHROPIC_API_KEY=
# The unpacked flowpay-dataset/ folder from the KamaAgenticRAG course, outside the repo.
FLOWPAY_DATASET_ROOT=~/flowpay-dataset
# The local pgvector from docker-compose.yml.
YFR_PG_URL=postgresql://flowpay:flowpay@127.0.0.1:5432/flowpay
